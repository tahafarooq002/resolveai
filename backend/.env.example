# ======================
# ResolveAI Environment
# ======================

# Application
ENVIRONMENT=development
PROJECT_NAME=ResolveAI
API_V1_STR=/api/v1
SECRET_KEY=please-change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=resolveai

# ======================
# LLM - Groq is primary
# ======================
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=groq
DEFAULT_CHAT_MODEL=llama-3.3-70b-versatile

# Optional OpenAI (for embeddings later)
OPENAI_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# File Upload
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_TYPES=[".pdf",".docx",".txt",".csv",".md"]

# Security
RATE_LIMIT_PER_MINUTE=60
